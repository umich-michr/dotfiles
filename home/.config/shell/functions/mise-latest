  echo "🔍 Fetching latest versions for all Mise tools..."
  
  # 1. Update the list of available versions
  mise plugins update
  
  # 2. Install the absolute latest for every currently used tool
  # This wont remove your old ones, it just adds the new ones
  mise install latest
  
  # 3. Set the global config to point to those latest versions
  mise use --global latest
  
  echo "✅ Mise global defaults updated to latest stable releases."
  mise ls --current